---
import GlobalLayout from "../layouts/GlobalLayout.astro";
import Starfield from "../components/Starfield.astro";

import ContentSection from "../components/ContentSection.astro";
import DefPopover from "../components/DefPopover.astro";

import MusicTurntable from "../components/MusicTurntable.astro";
import SteamActivity from "../components/SteamActivity.astro";

import "../global.css";
---

<GlobalLayout>
    <div class="starfield-container">
        <Starfield />
        <div class="starfield-vignette"></div>
        <h2>
            my quiet <i style="color: var(--base06)">little</i> shithole
        </h2>
    </div>

    <main>
        <article>
            <ContentSection subheading="about">
                <p>Hello, I'm bingpie! c:</p>
                <p>
                    I'm a{" "}
                    {(today = new Date()) =>
                        today.getFullYear() -
                        2008 -
                        +!(
                            today.getMonth() >= 1 ||
                            (today.getMonth() === 0 && today.getDate() >= 25)
                        )
                    }
                    -year-old
                    <DefPopover
                        term="neek"
                        def="nerd + geek. an uninteresting or unpopular person with irritatingly stupid, niche interests"
                    >
                        neek
                    </DefPopover>
                    from the UK.
                </p>
                <p>
                    This is the part where I'd like to say what "the thing that
                    I do" is, but I'm the embodiment of "jack of all trades,
                    master of none". My <i>thing</i> is my lack of one
                    particular <i>thing</i>. Except I'm less of a jack and more
                    of maybe a three or four.
                </p>
                <p>
                    Clubs. Hearts aren't my speed and all the others are too
                    pointy.
                </p>
            </ContentSection>

            <ContentSection subheading="Things I do">
                <p>
                    My interests are{" "}
                    <a
                        href="https://en.wikipedia.org/wiki/Attention_deficit_hyperactivity_disorder"
                        target="_blank"
                        rel="noopener noreferrer"
                    >
                        very scattered and sporadic and they effectively change
                        every day
                    </a>
                    . Though they do tend towards one of a few themes:
                </p>
                <ul>
                    <li>design</li>
                    <li>photography</li>
                    <li>programming</li>
                    <li>writing</li>
                </ul>
                <p>
                    This absolutely isn't to say that I'm much good at any of
                    those things — see above — but I do my best c:
                </p>
            </ContentSection>

            <ContentSection subheading="Projects">
                <p>I'm not up to anything right now. I know, I'm boring.</p>
                <p>
                    Genuinely though, I've been having some trouble in the last
                    few years with my creativity and motivation, but I'm going
                    to be working on that. Watch this (currently very empty)
                    space!
                </p>
            </ContentSection>

            <ContentSection subheading="Music">
                <MusicTurntable />
            </ContentSection>

            <ContentSection subheading="Steam">
                <SteamActivity />
            </ContentSection>
        </article>
    </main>
</GlobalLayout>

<style>
    .starfield-container {
        position: relative;

        border-style: solid;
        border-width: 0.5px;
        border-image: var(--gradient-border-radial);
        border-inline: none;

        display: flex;
        align-items: center;
        justify-content: center;

        margin-inline: auto;
        margin-bottom: 2rem;

        width: var(--content-width);
        height: 24rem;
        overflow: hidden;

        @media only screen and (max-width: 768px) {
            width: 100vw;

            margin-bottom: -8rem;
            border-bottom: none;
        }
    }

    .starfield-container > h2 {
        position: absolute;
        z-index: 2;

        transform: translate(-50%, -50%);
        top: 50%;
        left: 50%;

        width: 100%;
        margin: 0;

        pointer-events: none;

        font-size: 2em;
        font-weight: 500;
        text-align: center;

        @media only screen and (max-width: 768px) {
            top: 9rem;
        }
    }

    .starfield-vignette {
        position: absolute;
        inset: 0;
        pointer-events: none;
        box-shadow: inset 0 0 10rem 4rem var(--base00);
        mask: radial-gradient(transparent, rgba(0, 0, 0, 0.4) 20%, black 80%);
        background-image: linear-gradient(
            to left,
            var(--base00) 10%,
            transparent,
            var(--base00) 90%
        );
        backdrop-filter: blur(100px);

        @media only screen and (max-width: 768px) {
            mask: radial-gradient(
                ellipse at top,
                transparent,
                rgba(0, 0, 0, 0.4) 20%,
                black 80%
            );
            background-image: linear-gradient(transparent, var(--base00));
        }
    }
</style>
