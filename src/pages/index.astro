---
import GlobalLayout from "../layouts/GlobalLayout.astro";
import MusicHistoryList from "../components/MusicHistoryList.astro";
import Starfield from "../components/Starfield.astro";

import "../style.css";
---

<GlobalLayout>
	<div id="star-field-container">
		<Starfield />
		<div id="star-field-vignette"></div>
		<h2>
			my quiet <i style="color: var(--base06)">little</i> shithole
		</h2>
	</div>

	<main>
		<article>
			<section class="section about">
				<h3 class="subheading">About</h3>
				<div class="section-content">
					<p>
						Hello, I'm bingpie. I'm a <span class="age"></span>yo{" "}
						<span
							class="dict"
							data-def="nerd + geek. a dull or unpopular person, especially one who is interested in niche subjects"
						>
							neek
						</span>{" "}
						from the UK.
					</p>
					<p>
						This is the part where I'd like to say what "the thing
						that I do" is, but I'm the embodiment of "jack of all
						trades, master of none". My <i>thing</i> is my lack of
						one particular <i>thing</i>.
					</p>
					<p>
						Except I'm less of a jack and more of maybe a three or
						four. Clubs. Hearts aren't my speed and all the others
						are too pointy.
					</p>
				</div>
			</section>

			<section class="section things">
				<h3 class="subheading">Things I do</h3>
				<div class="section-content">
					<p>
						My interests are very scattered and sporadic, and so
						they effectively change every day. They do tend towards
						one of a few themes, though:
					</p>
					<ul>
						<li>design</li>
						<li>photography</li>
						<li>programming</li>
						<li>writing</li>
					</ul>
					<p>
						This absolutely isn't to say that I'm much good at any
						of those things — see above — but I do my best c:
					</p>
				</div>
			</section>

			<section class="section projects">
				<h3 class="subheading">Projects</h3>
				<div class="section-content">
					<p>I'm not up to anything right now. I know, I'm boring.</p>
					<p>
						Genuinely though, I've been having some trouble in the
						last few years with my creativity and motivation, but
						I'm going to be working on that. Watch this currently
						very empty space c:
					</p>
				</div>
			</section>

			<section class="section music-activity">
				<h3 class="subheading">Music</h3>
				<div class="section-content">
					<MusicHistoryList />
				</div>
			</section>
		</article>
	</main>
</GlobalLayout>
