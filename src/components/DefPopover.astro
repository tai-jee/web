---
interface Props {
    term: string;
    def: string;
}

const { term, def } = Astro.props;
const anchor = `--def-word-${crypto.randomUUID()}`;
---

<span class="dict" data-def={def} style={{ anchorName: anchor }}>
    <slot />
</span>
<aside popover="hint" class="dict-popover" style={{ positionAnchor: anchor }}>
    <p class="dict-term">{term}</p>
    <p class="dict-def">{def}</p>
</aside>
<script>
    //     Array.from(
    //         document.getElementsByClassName(
    //             "dict",
    //         ) as HTMLCollectionOf<HTMLElement>,
    //     ).forEach((word, i) => {
    //         const anchor = `--def-word-${i}`;
    //         word.style.setProperty("anchor-name", anchor);
    //
    //         const pop = document.createElement("aside");
    //         pop.popover = "hint";
    //         pop.classList.add("dict-popover");
    //         pop.style.setProperty("position-anchor", anchor);
    //
    //         word.addEventListener("mouseenter", () => pop.showPopover());
    //         word.addEventListener("mouseleave", () => pop.hidePopover());
    //         word.addEventListener("click", () => pop.togglePopover());
    //     });

    const text = document.querySelector(".dict") as HTMLSpanElement;
    const popover = document.querySelector(".dict-popover")! as HTMLElement;

    text.addEventListener("mouseenter", () => popover.showPopover());
    text.addEventListener("mouseleave", () => popover.hidePopover());
    text.addEventListener("click", () => popover.togglePopover());
</script>

<style>
    .dict {
        cursor: help;
        color: var(--base0E);
        border-bottom: 0.05rem dashed var(--base02);
    }

    [popover] {
        animation: fade-out 0.2s ease-out;

        position-area: bottom;
        position-try-fallbacks:
            flip-block,
            flip-inline,
            flip-block flip-inline;
        inset: auto;

        width: min(60rch, calc(100% - 2rch));
        padding: 12pt;
        margin: 1rch;

        border-radius: 12pt;
        border: 0.2pt solid var(--base01);

        color: inherit;

        background-color: color-mix(in srgb, var(--base00), transparent 20%);
        backdrop-filter: blur(6px);

        box-shadow:
            0 4px 8px 0 rgba(0, 0, 0, 0.2),
            0 6px 20px 0 rgba(0, 0, 0, 0.19);
    }

    .dict-term,
    .dict-def {
        margin: 0;
    }

    .dict-term {
        font-weight: bold;
        font-style: italic;
        color: var(--base03);
    }
</style>
