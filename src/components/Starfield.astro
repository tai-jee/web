<canvas id="starfield"></canvas>

<script>
	const STAR_COLOR = window
		.getComputedStyle(document.body)
		.getPropertyValue("--base02");
	const STAR_SIZE = 3;
	const STAR_MIN_SCALE = 0.01;
	const OVERFLOW_THRESHOLD = 10;
	const STAR_COUNT = (window.innerWidth + window.innerHeight) / 3;

	const canvas = document.querySelector("canvas")! as HTMLCanvasElement,
		context = canvas.getContext("2d", { alpha: true })!;

	let scale = 1, // device pixel ratio
		width: number,
		height: number;

	let stars: Array<{
		x: number;
		y: number;
		z: number;
	}> = [];

	let pointerX: number | null, pointerY: number | null;

	let velocity = { x: 0, y: 0, tx: 0, ty: 0, z: 0.001 };

	let touchInput = false;

	generate();
	resize();
	step();

	window.onresize = resize;
	canvas.onmousemove = onMouseMove;
	canvas.ontouchmove = onTouchMove;
	canvas.ontouchend = onMouseLeave;
	document.onmouseleave = onMouseLeave;

	function generate() {
		for (let i = 0; i < STAR_COUNT; i++) {
			stars.push({
				x: 0,
				y: 0,
				z: STAR_MIN_SCALE + Math.random() * (1 - STAR_MIN_SCALE),
			});
		}
	}

	function placeStar(star: { x: number; y: number; z: number }) {
		star.x = Math.random() * width;
		star.y = Math.random() * height;
	}

	function recycleStar(star: { x: number; y: number; z: number }) {
		let direction = "z";

		let vx = Math.abs(velocity.x),
			vy = Math.abs(velocity.y);

		if (vx > 1 || vy > 1) {
			let axis;

			if (vx > vy) {
				axis = Math.random() < vx / (vx + vy) ? "h" : "v";
			} else {
				axis = Math.random() < vy / (vx + vy) ? "v" : "h";
			}

			if (axis === "h") {
				direction = velocity.x > 0 ? "l" : "r";
			} else {
				direction = velocity.y > 0 ? "t" : "b";
			}
		}

		star.z = STAR_MIN_SCALE + Math.random() * (1 - STAR_MIN_SCALE);

		if (direction === "z") {
			star.z = 0.1;
			star.x = Math.random() * width;
			star.y = Math.random() * height;
		} else if (direction === "l") {
			star.x = -OVERFLOW_THRESHOLD;
			star.y = height * Math.random();
		} else if (direction === "r") {
			star.x = width + OVERFLOW_THRESHOLD;
			star.y = height * Math.random();
		} else if (direction === "t") {
			star.x = width * Math.random();
			star.y = -OVERFLOW_THRESHOLD;
		} else if (direction === "b") {
			star.x = width * Math.random();
			star.y = height + OVERFLOW_THRESHOLD;
		}
	}

	function resize() {
		scale = Math.min(window.devicePixelRatio, 2.5);

		const rect = canvas.parentElement!.getBoundingClientRect();
		width = Math.round(rect.width * scale);
		height = Math.round(rect.height * scale);

		canvas.width = width;
		canvas.height = height;

		canvas.style.width = rect.width + "px";
		canvas.style.height = rect.height + "px";

		stars.forEach(placeStar);
	}

	function step() {
		context.clearRect(0, 0, width, height);

		update();
		render();

		requestAnimationFrame(step);
	}

	function update() {
		velocity.tx *= 0.99;
		velocity.ty *= 0.99;

		velocity.x += (velocity.tx - velocity.x) * 0.1;
		velocity.y += (velocity.ty - velocity.y) * 0.1;

		for (let i = 0; i < stars.length; i++) {
			const star = stars[i];
			star.x += velocity.x * star.z;
			star.y += velocity.y * star.z;

			star.x += (star.x - width / 2) * velocity.z * star.z;
			star.y += (star.y - height / 2) * velocity.z * star.z;
			star.z += velocity.z;

			// recycle when out of bounds
			if (
				star.x < -OVERFLOW_THRESHOLD ||
				star.x > width + OVERFLOW_THRESHOLD ||
				star.y < -OVERFLOW_THRESHOLD ||
				star.y > height + OVERFLOW_THRESHOLD
			) {
				recycleStar(star);
			}
		}
	}

	function render() {
		let tailX = velocity.x * 1.2;
		let tailY = velocity.y * 1.2;
		if (Math.abs(tailX) < 0.1) tailX = 0.5;
		if (Math.abs(tailY) < 0.1) tailY = 0.5;

		context.lineCap = "round";
		context.strokeStyle = STAR_COLOR;

		let currentLineWidth = -1;

		for (let i = 0; i < stars.length; i++) {
			const star = stars[i];
			const newLineWidth = STAR_SIZE * star.z * scale;

			// If the line width changed, it's a new "bucket"
			if (newLineWidth !== currentLineWidth) {
				// Finish the previous path
				if (currentLineWidth !== -1) {
					context.stroke();
				}

				// Start a new batch
				context.beginPath();
				context.lineWidth = newLineWidth;
				context.globalAlpha = 0.8; // Use a stable alpha!
				currentLineWidth = newLineWidth;
			}

			context.moveTo(star.x, star.y);
			context.lineTo(star.x + tailX, star.y + tailY);
			// Notice: We DON'T call context.stroke() here anymore!
		}

		// Final stroke for the very last batch
		if (currentLineWidth !== -1) {
			context.stroke();
		}
	}

	function movePointer(x: number, y: number) {
		if (typeof pointerX === "number" && typeof pointerY === "number") {
			let ox = x - pointerX,
				oy = y - pointerY;

			velocity.tx =
				velocity.tx + (ox / 8) * scale * (touchInput ? 1 : -1);
			velocity.ty =
				velocity.ty + (oy / 8) * scale * (touchInput ? 1 : -1);
		}

		pointerX = x;
		pointerY = y;
	}

	function onMouseMove(event: MouseEvent) {
		touchInput = false;

		movePointer(event.clientX, event.clientY);
	}

	function onTouchMove(event: TouchEvent) {
		touchInput = true;

		movePointer(event.touches[0].clientX, event.touches[0].clientY);

		event.preventDefault();
	}

	function onMouseLeave() {
		pointerX = null;
		pointerY = null;
	}
</script>
